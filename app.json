{
  "expo": {
    "name": "Little Bites, Big World",
    "slug": "littlebites",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./src/assets/icons/app-icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "scheme": "littlebites",
    "splash": {
      "image": "./src/assets/icons/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#F1EFE8"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.littlebites.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./src/assets/icons/adaptive-icon.png",
        "backgroundColor": "#F1EFE8"
      },
      "package": "com.littlebites.app",
      "edgeToEdgeEnabled": true
    },
    "web": {
      "favicon": "./src/assets/icons/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
