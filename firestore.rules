rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ──────────────────────────────────────────────────────────────

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // ── users/{userId} ────────────────────────────────────────────────────────

    match /users/{userId} {
      allow read:   if isOwner(userId);
      allow create: if isOwner(userId);
      // Client can update most fields but NOT activeCharacter via unlock path
      // (that's handled after Cloud Function confirms unlock)
      allow update: if isOwner(userId);
      allow delete: if false;

      // ── children subcollection ──────────────────────────────────────────────

      match /children/{childId} {
        allow read, write: if isOwner(userId);
      }

      // ── preferences subcollection ───────────────────────────────────────────

      match /preferences/{childId} {
        allow read, write: if isOwner(userId);
      }

      // ── mealPlans subcollection ─────────────────────────────────────────────

      match /mealPlans/{weekId} {
        allow read, write: if isOwner(userId);
      }

      // ── passport subcollection ──────────────────────────────────────────────
      // Clients can read. Only Cloud Functions increment stamp counts.

      match /passport/{docId} {
        allow read: if isOwner(userId);
        // Client cannot write stamp counts — Cloud Function only
        allow write: if false;
      }

      // ── unlocks subcollection ───────────────────────────────────────────────
      // Clients can read and set the starter pair during onboarding.
      // milestones field is written exclusively by Cloud Functions.

      match /unlocks/{docId} {
        allow read: if isOwner(userId);
        // Allow create only (onboarding sets starter pair)
        allow create: if isOwner(userId)
          && request.resource.data.keys().hasOnly([
              'userId', 'updatedAt', 'unlockedPairs', 'starterPair', 'milestones'
            ])
          && request.resource.data.milestones.mealsCooked == 0
          && request.resource.data.milestones.cuisinesTried == 0
          && request.resource.data.milestones.passportStamps == 0;
        // Client can update activeCharacter (switching pairs) but not milestones
        allow update: if isOwner(userId)
          && !request.resource.data.diff(resource.data).affectedKeys()
              .hasAny(['milestones']);
        allow delete: if false;
      }
    }

    // ── recipes/{recipeId} ────────────────────────────────────────────────────
    // Any authenticated user can read. Only admin SDK (Cloud Functions) can write.

    match /recipes/{recipeId} {
      allow read:  if isSignedIn();
      allow write: if false;
    }

    // ── cuisines/{cuisineId} ──────────────────────────────────────────────────

    match /cuisines/{cuisineId} {
      allow read:  if isSignedIn();
      allow write: if false;
    }
  }
}
